   "id": "BL-609",
   "short_name": "LEGEND_TAKES_MINIMAP",
   "title": "A lens legend takes the minimap's space, for every lens",
   "priority": "A",
   "difficulty": 3,
   "category": "UI",
   "files": [
    "src/ui/body_surface_canvas.cpp",
    "src/ui/shell_metrics.cpp",
